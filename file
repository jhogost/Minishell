#include "minishell.h"

int	ft_strchri(const char *s, int c)
{
	int		i;

	if (!s)
		return (-42);
	i = 0;
	while (s[i] != '\0')
	{
		if (s[i] == (char)c)
			return (i);
		i++;
	}
	if ((char)c == '\0')
		return (i);
	return (-42);
}
