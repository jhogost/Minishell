#include "minishell.h"

int	quote_closed(char *s)
{
	int		i;
	char	quote;
	int		count;

	i = 0;
	count = 0;
	while (s[i])
	{
		if (s[i] == '\'' || s[i] == '"')
		{
			quote = s[i];
			count++;
			i++;
			while (s[i] && s[i] != quote)
				i++;
			if (s[i] == quote)
				count++;
		}
		if (s[i] == '\0')
			break ;
		i++;
	}
	return (count % 2 == 0);
}

int	verify_line(char *line)
{
	if (!line)
		return (-1);
	if (count_tokens(line) == -42)
		return (printf("Syntax error: too many operators\n"), -42);
	if (line[0] == '|' || line[0] == '&')
		return (printf("Syntax error: unexpected token `%c'\n", line[0]), -42);
	if (quote_closed(line) == 0)
		return (printf("Syntax error: unclosed quote\n"), -42);
	return (0);
}

int	loop_count_tokens(char *word, int *i, int *count, char *operator)
{
	*count = 0;
	if (word[*i] == '\'' || word[*i] == '"')
	{
		*operator = word[*i];
		*i += 1;
		while (word[*i] && word[*i] != *operator)
			*i += 1;
	}
	else if (is_operator(word[*i]))
	{
		*operator = word[*i];
		*count += 1;
		while (is_operator(word[*i]) && word[*i] == *operator)
		{
			*count += 1;
			*i += 1;
		}
		if (*count > 3)
			return (-42);
	}
	else
		*i += 1;
	return (0);
}

int	count_tokens(char *word)
{
	int		i;
	int		count;
	char	operator;

	i = 0;
	count = 0;
	while (word[i])
	{
		if (loop_count_tokens(word, &i, &count, &operator) == -42)
			return (-42);
	}
	return (0);
}
